# Copia aquest fitxer com a .env per veure el solucionari en local (npm run dev).
# A Netlify NO el defineixis si vols que la web pública només tingui les pàgines de l'alumnat.
INCLUDE_SOLUCIONARI=true

# Adreça de correu a la qual s'envia la feina (enllaç de l'última pàgina).
# Si no es defineix, el correu s'obre sense destinatari i l'alumne l'escriu. Atenció: l'adreça serà visible a la web.
PUBLIC_EMAIL_ENTREGA=docent@exemple.cat
